# Application
APP_ENV=development

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Database
DATABASE_URL=

# Authentication
SECRET_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,http://127.0.0.1:5173

# Email verification (required for new accounts; existing accounts stay verified)
EMAIL_VERIFICATION_REQUIRED=true
# Second sign-in step: a six-digit code emailed after the password (true by default)
LOGIN_OTP_REQUIRED=true
# Development only: print codes and links in the backend terminal when email delivery fails (off by default)
EMAIL_DEV_FALLBACK=false
# Let demo accounts stored as owner+tag@gmail.com sign in with tag@gmail.com (dev/demo only)
PLUS_ALIAS_LOGIN=false
FRONTEND_BASE_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_SSL=false
SMTP_USE_STARTTLS=true

# Frontend (set in frontend/.env.local)
VITE_CLERK_PUBLISHABLE_KEY=

# Social sign-in is activated only after each provider application is registered.
# Keep provider secrets in the local .env, never in source control.

# Vector database
CHROMA_PERSIST_DIRECTORY=

# ML (fine-tuned model is stored in Git LFS)
EMBEDDING_MODEL=./backend/ml_models/alumniconnect_sbert_finetuned

# LLM / RAG provider
LLM_API_KEY=
# Claude model for "Ask the library" (answers come only from published library text)
LLM_MODEL=claude-opus-5-5
RAG_TOP_K=4
RAG_MIN_SIMILARITY=0.25
RAG_QUESTIONS_PER_HOUR=30
